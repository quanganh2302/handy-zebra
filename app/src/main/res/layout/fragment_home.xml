<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Device Name - Simple Version -->
    <LinearLayout
        android:id="@+id/layoutDeviceInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@+id/layoutButtons"
        app:layout_constraintEnd_toEndOf="@id/layoutButtons"
        app:layout_constraintStart_toStartOf="@id/layoutButtons"
        app:layout_constraintWidth_percent="0.9">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/device_name"
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvDeviceName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold"
            tools:text="civn26t01" />
    </LinearLayout>

    <!-- Buttons Section -->
    <LinearLayout
        android:id="@+id/layoutButtons"
        android:layout_width="0dp"
        android:orientation="vertical"
        app:layout_constraintWidth_percent="0.9"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <Button
            android:id="@+id/btnKiemHang"
            android:layout_width="match_parent"
            android:layout_height="92dp"
            android:layout_weight="0.5"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_btn_primary"
            android:textColor="@color/black"
            android:textSize="24sp"
            android:text="@string/btn_kiem_hang" />

<!--        <Button-->
<!--            android:id="@+id/btnKiemNhan"-->
<!--            android:layout_width="match_parent"-->
<!--            android:layout_height="0dp"-->
<!--            android:layout_weight="0.5"-->
<!--            android:background="@drawable/bg_btn_primary"-->
<!--            android:textSize="24sp"-->
<!--            android:textColor="@color/black"-->
<!--            android:text="@string/btn_kiem_nhan" />-->
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>