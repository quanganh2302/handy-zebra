<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Cho phép HTTP cleartext traffic (không mã hóa)
        CHỈ dùng cho Development/Testing
        Production nên tắt và dùng HTTPS
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!--
        Hoặc nếu muốn chặt chẽ hơn, chỉ cho phép local network:
        Bỏ comment phần dưới và comment phần base-config ở trên
    -->
    <!--
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">192.168.*.*</domain>
        <domain includeSubdomains="true">10.*.*.*</domain>
        <domain includeSubdomains="true">172.16.*.*</domain>
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
    -->
</network-security-config>